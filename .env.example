# Copier en .env — NE JAMAIS COMMITER .env
# DexScreener et RugCheck ne demandent aucune clé.

HELIUS_API_KEY=
# Requêtes Helius par seconde, tout le processus. Défaut 2 si vide.
HELIUS_MAX_PER_SECOND=2
BIRDEYE_API_KEY=
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Jupiter — prix par lot (50 mints en 1 appel) et impact de prix reel.
# Cle depuis developers.jup.ag/portal. Palier Free = 1 requete/seconde.
# Le bot n'appelle QUE /price et /swap/v2/order (devis). L'execution
# (/swap/v2/execute, /swap/v2/build) est hors liste blanche et le restera :
# voir ALLOWED_PATHS dans src/apis/jupiter.py.
JUPITER_API_KEY=

# GMGN — smart money (lecture seule côté bot).
# LES DEUX sont requises. Générer avec : gmgn-cli config
# puis appliquer avec : gmgn-cli config --apply <API_KEY>
# ⚠️ GMGN_PRIVATE_KEY autorise des transactions réelles côté GMGN.
#    Le bot ne s'en sert jamais (liste blanche lecture seule dans
#    src/apis/gmgn.py) mais traite-la comme une clé de wallet.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=

# PAPER | LIVE — laisser PAPER tant que win_rate < 40% sur 20 trades

# Chainstack — RPC Solana JSON (copy_smart / onchain_antirug).
# Helius reste séparé (DAS / holders) et sert AUSSI de secours RPC
# si Chainstack répond 401/403 (plan Developer : archive / holders limités).
# Preferé : basic auth (console → Access credentials) :
CHAINSTACK_USERNAME=
CHAINSTACK_PASSWORD=
# Alternatif : URL avec jeton en path, ou jeton seul :
CHAINSTACK_AUTH_TOKEN=
CHAINSTACK_RPC_URL=
TRADING_MODE=PAPER

# Firecrawl — utilisée hors boucle bot (recherche/scraping en session dev).
FIRECRAWL_API_KEY=
# Copier en .env — NE JAMAIS COMMITER .env
# DexScreener et RugCheck ne demandent aucune clé.


# Veille (scripts/veille.py, docs/HEBERGEMENT.md) — facultatif.
# Adresse de ping healthchecks.io : prévient si le Mac entier s'éteint,
# ce que la veille locale ne peut pas voir. Traiter comme un secret léger.
HEALTHCHECK_PING_URL=

# Jeton du site (api/server.py). Vide = aucune authentification : acceptable
# tant que uvicorn n'écoute que 127.0.0.1 SANS tunnel. OBLIGATOIRE dès qu'un
# tunnel (Cloudflare, ngrok, tailscale serve/funnel) expose le site : les
# requêtes du tunnel arrivent depuis 127.0.0.1. Protège /api/params (la
# stratégie complète) et la boîte de demandes Liquid. Lecture locale sans
# jeton : python scripts/voir_bras.py <bras>
DASHBOARD_TOKEN=
