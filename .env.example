# Copier en .env — NE JAMAIS COMMITER .env
# DexScreener et RugCheck ne demandent aucune clé.

HELIUS_API_KEY=
BIRDEYE_API_KEY=
TWITTER_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Jupiter — prix par lot (50 mints en 1 appel) et impact de prix reel.
# Cle depuis developers.jup.ag/portal. Palier Free = 1 requete/seconde.
# Le bot n'appelle QUE /price et /swap/v2/order (devis). L'execution
# (/swap/v2/execute, /swap/v2/build) est hors liste blanche et le restera :
# voir ALLOWED_PATHS dans src/apis/jupiter.py.
JUPITER_API_KEY=

# GMGN — smart money (lecture seule côté bot).
# LES DEUX sont requises. Générer avec : gmgn-cli config
# puis appliquer avec : gmgn-cli config --apply <API_KEY>
# ⚠️ GMGN_PRIVATE_KEY autorise des transactions réelles côté GMGN.
#    Le bot ne s'en sert jamais (liste blanche lecture seule dans
#    src/apis/gmgn.py) mais traite-la comme une clé de wallet.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=

# PAPER | LIVE — laisser PAPER tant que win_rate < 40% sur 20 trades
TRADING_MODE=PAPER
