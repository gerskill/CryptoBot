#!/bin/sh
# pre-commit — barrage anti-fuite de secrets.
# Applique la regle « Aucune cle en dur » d'AGENTS.md, que git ne peut pas
# faire respecter tout seul : les hooks ne sont jamais clones.
# Installation : ./scripts/install_hooks.sh
#
# Trois barrages, sur l'index uniquement (jamais sur le repertoire de travail) :
#   1. un fichier d'environnement reel mis en index (.env, .env.local, ...),
#      les modeles (.env.example, .env.sample) restant autorises ;
#   2. dans les lignes AJOUTEES, une variable sensible qui recoit une vraie
#      valeur — c'est ce barrage qui rattrape un .env.example rempli par erreur ;
#   3. quelques empreintes de secrets reconnaissables quel que soit le contexte
#      (cle privee PEM, token Telegram, bearer Twitter, tableau de cle Solana).
#
# Contournement assume : git commit --no-verify. C'est un garde-fou, pas un
# coffre-fort ; il ne dispense pas de relire `git diff --cached`.

set -u

fail=0
entete() { [ "$fail" -eq 0 ] && printf '\nCommit bloque — secrets detectes :\n\n' >&2; fail=1; }

fichiers=$(git diff --cached --name-only --diff-filter=ACM)

# --- Barrage 1 : fichiers d'environnement ------------------------------------
for f in $fichiers; do
  case "${f##*/}" in
    .env.example|.env.sample|.env.template) continue ;;
    .env|.env.*|*.env)
      entete
      printf 'Fichier d environnement en index : %s\n' "$f" >&2
      printf '  git restore --staged "%s"   puis verifier .gitignore\n' "$f" >&2
      ;;
  esac
done

# Nom sensible. TOKEN doit etre QUALIFIE (BOT_TOKEN, BEARER_TOKEN, ...) :
# dans un bot memecoin, un « token » nu designe une piece, pas un identifiant
# — TOKEN = "Mint1111..." dans les tests est une adresse publique. Un vrai
# token Telegram ou Twitter reste attrape par les empreintes, quel que soit
# le nom de la variable.
NOM_SENSIBLE='[A-Z0-9_]*(API_?KEY|SECRET|PRIVATE_KEY|BEARER|PASSWORD|PASSWD|CHAT_ID|ACCESS_KEY|(BOT|BEARER|ACCESS|AUTH|API|REFRESH|SESSION)_TOKEN)[A-Z0-9_]*'

# Valeurs inoffensives : placeholders et mots-vides.
PLACEHOLDER='^(x{3,}|todo|tbd|changeme|placeholder|none|null|empty|vide|\.\.\.|(your|votre|my|ma|mon|the)[_-]?[a-z_-]*)$'

# Empreintes de secrets, quel que soit le nom de variable.
EMPREINTES='(-----BEGIN [A-Z ]*PRIVATE KEY-----|[0-9]{8,10}:[A-Za-z0-9_-]{30,}|AAAAAAAAAAAAAAAAAAAAA[A-Za-z0-9%_-]{20,}|\[( *[0-9]{1,3},){63,} *[0-9]{1,3} *\])'

for f in $fichiers; do
  # Ignorer les binaires : numstat rend "-" pour les deux compteurs.
  [ "$(git diff --cached --numstat -- "$f" | cut -f1)" = "-" ] && continue

  ajouts=$(git diff --cached -U0 -- "$f" | sed -n 's/^+\([^+].*\)$/\1/p')
  [ -n "$ajouts" ] || continue

  # --- Barrage 2 : VARIABLE_SENSIBLE = valeur reelle -------------------------
  suspects=$(printf '%s\n' "$ajouts" \
    | grep -nE "^[[:space:]]*(export[[:space:]]+)?${NOM_SENSIBLE}[[:space:]]*=" \
    | while IFS= read -r ligne; do
        valeur=$(printf '%s' "$ligne" | sed 's/^[0-9]*://' | cut -d= -f2- \
                 | sed 's/[[:space:]]*#.*$//' | tr -d '"'"'"'"' \
                 | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')

        [ -n "$valeur" ] || continue

        # Code, interpolation, placeholder chevronne : os.getenv(...),
        # os.environ[...], ${VAR}, <votre_cle>. Aucune cle reelle ne contient
        # ces caracteres — c'est au contraire le motif CORRECT a encourager.
        case "$valeur" in
          *'('*|*')'*|*'['*|*']'*|*'{'*|*'}'*|*'$'*|*'<'*|*'>'*|*','*) continue ;;
          *' '*|*'	'*) continue ;;
        esac

        printf '%s\n' "$valeur" | grep -qiE "$PLACEHOLDER" && continue

        # Une vraie cle fait au moins 8 caracteres.
        [ "${#valeur}" -ge 8 ] || continue

        printf '%s' "$ligne" | sed 's/=.*/=<valeur masquee>/'
      done)

  # --- Barrage 3 : empreintes ------------------------------------------------
  empreintes=$(printf '%s\n' "$ajouts" | grep -nE "$EMPREINTES" | cut -c1-45)

  if [ -n "$suspects" ] || [ -n "$empreintes" ]; then
    entete
    printf 'Valeur sensible ajoutee dans %s :\n' "$f" >&2
    [ -n "$suspects" ] && printf '%s\n' "$suspects" | sed 's/^/  ligne /' >&2
    [ -n "$empreintes" ] && printf '%s\n' "$empreintes" | sed 's/^/  empreinte ligne /' >&2
  fi
done

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

Les vraies valeurs vont dans .env (non versionne, chmod 600), jamais dans
.env.example ni dans le code. Si une cle est deja partie dans un commit,
considerez-la compromise et regenerez-la.

Faux positif ? git commit --no-verify
MSG
  exit 1
fi

exit 0
